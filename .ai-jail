# ai-jail sandbox configuration
# https://github.com/akitaonrails/ai-jail
# Edit freely. Regenerate with: ai-jail --clean --init

trust_project_config = ["~/git/crab-rave", "~/git/atomic-bench"]
command = ["pi"]
no_save_config = true
ro_maps = [
  "~/.nvm/versions/node",
  "~/git/dotfiles/.pi/agent",
  "~/.a-gents/skills",
]

[commands.pi]
allow_hosts = [
  "context7.com",
  "mcp.linear.app",
  "api.openai.com",
  "auth.openai.com",
  "chatgpt.com",
]
env_pass = [
  "NOMAD_ADDR",
  "NOMAD_TOKEN",
  "CONTEXT7_API_KEY",
  "NODE_USE_ENV_PROXY=1",
]
